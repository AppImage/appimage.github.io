---
layout: null
---
{
    "version": 1,
    "home_page_url": "{{ "/" | absolute_url }}",
    "feed_url": "{{ "/feed.json" | absolute_url }}",
    "description": {{ site.description | jsonify }},
    "icon": "{{ "/apple-touch-icon.png" | absolute_url }}",
    "favicon": "{{ "/favicon.ico" | absolute_url }}",
    "expired": false,
    {% if site.author %}
    "author": {% if site.author.name %} {
        "name": "{{ site.author.name }}",
        "url": {% if site.author.url %}"{{ site.author.url }}"{% else %}null{% endif %},
        "avatar": {% if site.author.avatar %}"{{ site.author.avatar }}"{% else %}null{% endif %}
    },{% else %}"{{ site.author }}",{% endif %}
    {% endif %}
"items": [
    {% comment %}Filter first, so that forloop.last is the last app (no trailing comma){% endcomment %}
    {% assign apps = site.pages | where: "layout", "app" | where_exp: "p", "p.published != false" | where_exp: "p", "p.published != 'false'" | sort: 'permalink' %}
    {% for post in apps %}
        {
        "name": {% if post.title %}{{ post.title | jsonify }}{% else %}{{ post.name | remove: ".md" | jsonify  }}{% endif %},
    {% if post.appdata.Description.C %}
        "description": {{ post.appdata.Description.C | jsonify }},
    {% elsif post.desktop["Desktop Entry"].Comment %}
        "description": {{ post.desktop["Desktop Entry"].Comment | jsonify }},
    {% endif %}
        "categories": [{{ post.desktop["Desktop Entry"].Categories | jsonify }}],
        "authors" : {{ post.authors | jsonify }},
        "license" : {{ post.license | jsonify }},
        "links": {{ post.links | jsonify }},
        "icons": {{ post.icons | jsonify }},
        "screenshots" : {{ post.screenshots | jsonify }}{% if post.desktop.AppImageHub.X-AppImage-Libc %},
        "libc": {{ post.desktop.AppImageHub.X-AppImage-Libc | jsonify }},
        "self_contained": {{ post.desktop.AppImageHub.X-AppImage-Self-Contained | jsonify }}{% if post.desktop.AppImageHub.X-AppImage-Glibc-Required %},
        "glibc_required": {{ post.desktop.AppImageHub.X-AppImage-Glibc-Required | remove: "GLIBC_" | jsonify }}{% endif %}{% endif %}
        }{% if forloop.last == false %},{% endif %}
    {% endfor %}
    ]
}
