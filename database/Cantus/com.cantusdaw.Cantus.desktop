[Desktop Entry]
Type=Application
Name=Cantus
GenericName=Digital Audio Workstation
GenericName[es]=Estación de trabajo de audio digital
Comment=Make music: record, arrange, mix and master
Comment[es]=Haz música: graba, arregla, mezcla y masteriza
Exec=cantus %f
Icon=com.cantusdaw.Cantus
Terminal=false
Categories=AudioVideo;Audio;Midi;Music;Recorder;Mixer;Sequencer;
Keywords=DAW;music;audio;MIDI;recording;mixing;mastering;synthesizer;CLAP;VST3;
Keywords[es]=DAW;música;audio;MIDI;grabación;mezcla;masterización;sintetizador;CLAP;VST3;
MimeType=application/x-cantus-project;
StartupNotify=true
StartupWMClass=cantus

[AppImageHub]
# Dear upstream developer, please include update information in your AppImage
# (e.g., with appimagetool -u) so that users can easily update the AppImage
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.35
