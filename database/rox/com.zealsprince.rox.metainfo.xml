<?xml version="1.0" encoding="UTF-8"?>
<!--
  The AppStream record every Linux channel installs under share/metainfo:
  the deb (Cargo.toml deb assets), nix (flake.nix postInstall), the AppImage
  and the tarball (release.yml), and the Flatpak, whose manifest renames it
  to com.zealsprince.rox.metainfo.xml and rewrites the launchable to match.

  The releases element is committed, newest first, one entry per stable
  version. scripts/bump-version.sh adds the entry in the commit that sets the
  version, so each tag carries its own complete list: Flathub builds from the
  tag and requires the metainfo to come from upstream, and every other
  channel installs this file as is. Candidates get no entry.
-->
<component type="desktop-application">
  <id>com.zealsprince.rox</id>
  <name>rox</name>
  <summary>A desktop music player for large, carefully tagged local libraries</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="com.zealsprince">
    <name>Andrew Lake</name>
  </developer>
  <launchable type="desktop-id">com.zealsprince.rox.desktop</launchable>
  <description>
    <p>
      rox is a desktop music player for people with large, carefully tagged
      local libraries. It reads full tags and true durations from every file
      on import, watches the library folders for changes, and stays fast at
      tens of thousands of tracks.
    </p>
    <p>
      The interface is panels you compose yourself: library, queue, playlists,
      lyrics, cover art, visualizers, and forty-odd more, each duplicated
      with its own settings, popped out into real windows, and saved as a
      workspace. A workspace is one file carrying the layout, palette, and
      appearance, so a look can be shared.
    </p>
    <p>
      Tagging is deep enough to trust with a real collection: a full tag
      editor with atomic writes, batch edits with find and replace, ratings
      stored in the files themselves, online lookup through MusicBrainz and
      others, lyrics, and ReplayGain for the files no tagger ever measured.
    </p>
  </description>
  <url type="homepage">https://rox.music</url>
  <url type="bugtracker">https://github.com/zealsprince/rox/issues</url>
  <url type="vcs-browser">https://github.com/zealsprince/rox</url>
