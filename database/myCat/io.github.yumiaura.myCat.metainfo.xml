  <launchable type="desktop-id">mycat.desktop</launchable>
  <url type="homepage">https://github.com/yumiaura/myCat</url>
  <url type="bugtracker">https://github.com/yumiaura/myCat/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>The cat on the desktop</caption>
      <image>https://raw.githubusercontent.com/yumiaura/myCat/main/docs/screenshot.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
</component>
