<component type="desktop-application">
  <id>io.github.yumiaura.myCat</id>
  <name>myCat</name>
  <summary>A tiny animated desktop pet cat</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <developer id="io.github.yumiaura">
    <name>yumiaura</name>
