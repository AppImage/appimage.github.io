<component type="desktop-application">
  <id>io.github.LucasPicoli._8B</id>
  <name>8B</name>
  <summary>Edit the profiles stored on an 8BitDo Pro 3</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.lucaspicoli">
    <name>Lucas Picoli</name>
  </developer>
  <description>
    <p>8B reads and edits the profiles stored on an 8BitDo Pro 3 over a USB cable. It edits button mapping, sticks, triggers and vibration in every slot of the XInput, Switch and DInput modes, clears slots, and imports and exports profiles as JSON.</p>
    <p>8B is an independent project, not made or endorsed by 8BitDo.</p>
  </description>
