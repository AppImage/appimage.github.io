[Desktop Entry]
Type=Application
Name=Paper Cut
GenericName=Paper Mario: The Thousand-Year Door, native
Comment=Play your own disc of Paper Mario: The Thousand-Year Door natively
Exec=papercut %u
Icon=io.github.llcoolt.PaperCut
Terminal=false
Categories=Game;
Keywords=paper;mario;ttyd;thousand-year door;gamecube;
MimeType=application/x-gamecube-rom;application/x-wii-rom;x-scheme-handler/papercut;
StartupWMClass=ttyd-us
PrefersNonDefaultGPU=true

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|LLCOOLT|paper-cut|latest|Paper_Cut-*-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.35
X-AppImage-Payload-License=MIT
