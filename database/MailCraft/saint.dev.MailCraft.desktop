[Desktop Entry]
Type=Application
Version=1.4
Name=MailCraft
GenericName=Mail Client
Comment=Read and write mail, and manage your calendar, contacts, tasks and notes
Exec=mailcraft
TryExec=mailcraft
Icon=saint.dev.MailCraft
Terminal=false
Categories=Office;Email;Calendar;ContactManagement;
MimeType=message/rfc822;application/mbox;text/calendar;text/vcard;x-scheme-handler/mailto;
Keywords=mail;email;e-mail;inbox;imap;smtp;calendar;contacts;tasks;notes;
StartupNotify=true
StartupWMClass=saint.dev.MailCraft

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|MonkeySaint|mailcraft|latest|MailCraft-*x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.35
X-AppImage-Payload-License=Apache-2.0
