{
  "name": "MQTTX",
  "version": "1.13.1",
  "description": "MQTT desktop client",
  "author": "EMQX Team <yusf@emqx.io>",
  "main": "background.js",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "electron-store": "^8.1.0",
    "fix-path": "3.0.0",
    "log4js": "^6.4.0",
    "mqtt": "4.3.7",
    "sqlite3": "5.1.6",
    "typedi": "^0.8.0",
    "typeorm": "^0.2.34",
    "typeorm-typedi-extensions": "^0.2.3",
    "vm2": "^3.9.18"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{vue,ts,js,scss}": [
      "prettier --write \"src/**/*.ts\" \"src/**/*.vue\" \"src/**/*.scss\" \"web/**/*.ts\" \"web/**/*.vue\" \"web/**/*.scss\" \"cli/**/*.ts\" \"cli/**/*.js\""
    ]
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/emqx/MQTTX",
  "resolutions": {
    "electron-builder": "23.6.0",
    "webpack": "4.47.0"
  }
}