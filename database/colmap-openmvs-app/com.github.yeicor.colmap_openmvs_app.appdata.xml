<component type="desktop-application">
  <id>com.github.yeicor.colmap_openmvs_app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Photos to 3D Model Offline</name>
  <summary>Photogrammetry app to create textured 3D models from photos offline</summary>
  <developer id="com.github.yeicor">
    <name>Yeicor</name>
  </developer>
  <description>
    <p>
      Photos to 3D Model Offline (colmap-openmvs-app) provides a local, offline photogrammetry pipeline using COLMAP and OpenMVS. It reconstructs dense 3D point clouds and textured meshes directly from sets of images, featuring an interactive 3D viewer and real-time pipeline monitoring.
    </p>
  </description>
  <launchable type="desktop-id">com.github.yeicor.colmap_openmvs_app.desktop</launchable>
  <url type="homepage">https://github.com/yeicor/colmap-openmvs-app</url>
  <url type="bugtracker">https://github.com/yeicor/colmap-openmvs-app/issues</url>
  <provides>
    <binary>colmap-openmvs-app</binary>
  </provides>
  <categories>
