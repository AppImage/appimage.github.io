{
  "name": "wispr-flow",
  "productName": "Wispr Flow",
  "version": "1.6.957",
  "base10CommitHash": "656b3fbfe214db4026fff75b3db650fc3edec8bb",
  "description": "Voice-typing made perfect",
  "main": ".webpack/main",
  "scripts": {
    "start": "cross-env NODE_ENV=development ELECTRON_ENABLE_LOGGING=1 electron-forge start --",
    "start-dev": "ts-node scripts/dev-start.ts",
    "package": "cross-env NODE_ENV=production electron-forge package",
    "package:unsigned": "cross-env NODE_ENV=production SKIP_SIGNING=1 electron-forge package",
    "make": "cross-env NODE_ENV=production electron-forge make",
    "release-dry-run": "cross-env NODE_ENV=production electron-forge publish --dry-run",
    "release-from-dry-run": "cross-env NODE_ENV=production electron-forge publish --from-dry-run",
    "format": "eslint --fix src/**/*.{ts,tsx} && stylelint '**/*.{css,scss}' --fix",
    "test": "cross-env ENVIRONMENT=development NODE_ENV=test jest",
    "test-backend": "cross-env ENVIRONMENT=development NODE_ENV=test jest src/main/backend/tests --testPathIgnorePatterns=[]",
    "test:encoder-memory-gate": "cross-env ENVIRONMENT=development NODE_ENV=test ENCODER_MEMORY_GATE=1 jest src/main/meetingRecorder/opusEncoder.worker.test.ts --runInBand -t 'memory bound'",
    "bundle-helper-schema": "ts-node ./src/api/bundleSchema.ts ./src/api/helper/schema.json ./src/api/helper/generated/bundledSchema.json",
    "generate-helper-ts-types": "quicktype -s schema ./src/api/helper/generated/bundledSchema.json --top-level HelperAPI -o ./src/api/helper/generated/models.ts && eslint --fix ./src/api/helper/generated/models.ts > /dev/null 2>&1 || true",
    "generate-helper-swift-types": "quicktype -s schema ./src/api/helper/generated/bundledSchema.json --top-level HelperAPI -o './swift-helper-app/Wispr Flow Helper/IPC/Models.swift'",
    "generate-helper-csharp-types": "quicktype -s schema ./src/api/helper/generated/bundledSchema.json --top-level HelperAPI --framework SystemTextJson -o \"./windows-helper-app/Wispr Flow Helper/IPC/Models.cs\" && node ./scripts/postprocess-helper-csharp.mjs \"./windows-helper-app/Wispr Flow Helper/IPC/Models.cs\"",
    "generate-helper-models": "yarn bundle-helper-schema && yarn generate-helper-ts-types && yarn generate-helper-swift-types && yarn generate-helper-csharp-types",
    "reset-profile": "./scripts/reset_permissions --full && rm -f ~/Library/Application\\ Support/Wispr\\ Flow/flow.sqlite",
    "typecheck": "yarn generate-css-types && node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:ts6": "yarn generate-css-types && node ./node_modules/typescript/bin/tsc6 --noEmit",
    "generate-css-types": "node scripts/generateScssModuleTypes.mjs",
    "postinstall": "yarn generate-css-types || echo '[scss-module-types] generation failed; typecheck and the dev server regenerate'",
    "dead-code": "node scripts/check-dead-code.mjs",
    "dead-code:all": "node scripts/check-dead-code.mjs --all",
    "ax-inspect": "node scripts/ax-inspect.mjs",
    "ax-inspect-serve": "node scripts/ax-inspect-server.mjs",
    "audit:components": "node scripts/component-usage/run.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve-storybook": "serve storybook-static",
    "sb": "yarn storybook",
    "e2e": "playwright test --config e2e/playwright.config.ts --project=all",
    "e2e:pr-gate": "playwright test --config e2e/playwright.config.ts --project=pr-gate",
    "e2e:notetaker-real": "playwright test --config e2e/playwright.config.ts --project=notetaker-real",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "e2e:codegen": "playwright codegen",
    "clean": "rm -rf .webpack node_modules/.cache"
  },
