[Desktop Entry]
Type=Application
Name=jsFileManager
GenericName=File Manager
Comment=Two-pane file manager with a progress bar you can actually read
Comment[de]=Zwei-Fenster-Dateimanager mit einer Fortschrittsanzeige, die man lesen kann
Exec=jsFileManager %F
Icon=jsfilemanager
Terminal=false
Categories=Utility;FileTools;FileManager;GTK;
Keywords=file;copy;move;manager;archive;tar;network;
Keywords[de]=Datei;kopieren;verschieben;Manager;Archiv;tar;Netzwerk;
StartupNotify=true
StartupWMClass=jsFileManager
MimeType=inode/directory;
X-AppImage-Version=1.0.0

[AppImageHub]
# Dear upstream developer, please include update information in your AppImage
# (e.g., with appimagetool -u) so that users can easily update the AppImage
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
