[Desktop Entry]
Type=Application
Name=jsBudbrainsPackOr
GenericName=Archive Manager
GenericName[de]=Archivprogramm
Comment=Pack and unpack by drag and drop
Comment[de]=Packen und Entpacken per Ziehen und Ablegen
Exec=jsBudbrainsPackOr %F
Icon=jsbudbrainspackor
Terminal=false
Categories=Utility;Archiving;Compression;
Keywords=zip;7z;tar;archive;pack;unpack;extract;compress;
MimeType=application/zip;application/x-7z-compressed;application/x-tar;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-zstd-compressed-tar;application/x-lz4-compressed-tar;
StartupWMClass=jsbudbrainspackor
X-AppImage-Version=1.0.0

[AppImageHub]
X-AppImage-UpdateInformation=zsync|https://www.budbrain.de/appimage/jsbudbrainspackor-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.34
