[Desktop Entry]
Name=Numa
GenericName=Photo Editor
Comment=Develop raw photographs
Exec=numa %U
Icon=com.tijmen.Numa
Terminal=false
Type=Application
Categories=Graphics;Photography;GNOME;GTK;
StartupNotify=true
MimeType=image/jpeg;image/png;image/tiff;image/webp;image/bmp;image/heic;image/heif;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-epson-erf;image/x-fuji-raf;image/x-hasselblad-3fr;image/x-hasselblad-fff;image/x-kodak-dcr;image/x-kodak-kdc;image/x-leaf-mos;image/x-minolta-mrw;image/x-nikon-nef;image/x-nikon-nrw;image/x-olympus-orf;image/x-panasonic-raw;image/x-panasonic-raw2;image/x-panasonic-rw2;image/x-pentax-pef;image/x-phaseone-iiq;image/x-samsung-srw;image/x-sigma-x3f;image/x-sony-arw;image/x-sony-sr2;image/x-sony-srf;image/x-dcraw;x-scheme-handler/numa;
Keywords=raw;photo;photography;develop;view;editor;edit;image;picture;cull;mask;lut;RAF;ARW;CR2;CR3;NEF;DNG;RW2;ORF;PEF;X3F;
X-AppImage-Version=0.46.0

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|simmmmm|Numa|latest|Numa-*-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.35
X-AppImage-Payload-License=GPL-3.0
