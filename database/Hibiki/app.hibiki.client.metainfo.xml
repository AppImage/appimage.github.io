<component type="desktop-application">
  <id>app.hibiki.client</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Hibiki</name>
  <summary>Listen to your Plex music library</summary>
  <description>
    <p>Hibiki is a desktop music player for Plex, with a native audio engine and an interface shaped by your library's artwork.</p>
    <p>Browse artists and albums, manage playlists, follow synced lyrics, and discover internet radio and podcasts. Save selected music for offline playback. Connect Last.fm or ListenBrainz for scrobbling and liked songs, and link playlists with ListenBrainz.</p>
  </description>
  <launchable type="desktop-id">Hibiki.desktop</launchable>
  <developer_name>Michael Karbowiak</developer_name>
  <url type="homepage">https://github.com/karbowiak/hibiki</url>
  <url type="bugtracker">https://github.com/karbowiak/hibiki/issues</url>
  <categories><category>AudioVideo</category><category>Audio</category><category>Player</category></categories>
  <provides><binary>hibiki</binary></provides>
