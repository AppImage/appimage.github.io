{
  "name": "wechat-claude-code",
  "version": "2026.4.12-15",
  "description": "Chat with Claude Code from WeChat — desktop app (Electron) + CLI",
  "license": "MIT",
  "author": "AceDataCloud",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "files": [
    "dist/**",
    "dist-electron/**",
    "electron/preload.cjs",
