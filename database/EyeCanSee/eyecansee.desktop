[Desktop Entry]
Type=Application
Name=EyeCanSee
GenericName=Image and Video Viewer and Manager
GenericName[it]=Visualizzatore e gestore di immagini e video
Comment=Viewer, manager and editor for photos, videos, 3D models and CAD drawings
Comment[it]=Visualizzatore, gestore ed editor di foto, video, modelli 3D e disegni CAD
Exec=eyecansee %f
Icon=eyecansee
Terminal=false
Categories=Graphics;Viewer;Photography;
Keywords=image;photo;video;viewer;heic;raw;immagini;foto;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/heic;image/heif;image/avif;image/jxl;image/svg+xml;image/x-tga;image/x-portable-anymap;image/x-exr;image/vnd.adobe.photoshop;image/x-xcf;image/x-dcraw;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-sony-arw;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;video/mp4;video/x-matroska;video/quicktime;video/webm;video/x-msvideo;model/stl;model/obj;model/gltf-binary;model/gltf+json;model/3mf;model/vnd.collada+xml;model/vrml;model/x3d+xml;model/x3d+vrml;image/x-3ds;model/step;model/iges;image/vnd.dxf;image/vnd.dwg;application/vnd.hp-hpgl;inode/directory;
StartupNotify=true
X-AppImage-Version=0.76.2

[AppImageHub]
# Dear upstream developer, please include update information in your AppImage
# (e.g., with appimagetool -u) so that users can easily update the AppImage
