[Desktop Entry]
Type=Application
Name=Budbrain Cave Rescue
GenericName=Rescue Flight
GenericName[de]=Rettungsflug
Comment=Fly into deep moon caves and bring stranded astronauts back home
Comment[de]=Fliege in tiefe Mondhöhlen und bring gestrandete Astronauten heim
Exec=jsBudbrainCaveRescue
Icon=jsBudbrainCaveRescue
Terminal=false
Categories=Game;ArcadeGame;
Keywords=cave;rescue;space;moon;astronaut;gravity;flying;spaceship;
Keywords[de]=Höhle;Rettung;Weltraum;Mond;Astronaut;Schwerkraft;Fliegen;Raumschiff;
StartupNotify=true
StartupWMClass=jsBudbrainCaveRescue
X-AppImage-Version=1.0.0

[AppImageHub]
X-AppImage-UpdateInformation=zsync|https://www.budbrain.de/appimage/jsbudbraincaverescue-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.34
