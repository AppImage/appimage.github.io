[Desktop Entry]
Type=Application
Version=1.0
Name=Vibe Wallet
GenericName=Solana Wallet
Comment=Non-custodial Solana wallet for Linux
Exec=vibe-wallet %u
Icon=com.vibewallet.App
Terminal=false
Categories=Office;Finance;GTK;
Keywords=solana;wallet;crypto;swap;stake;ledger;trezor;portfolio;
MimeType=x-scheme-handler/wc;x-scheme-handler/vibe-wallet;
StartupNotify=true
StartupWMClass=vibe-wallet
X-AppImage-Version=1.9.0

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|vibewalletsol|VibeWallet|latest|Vibe_Wallet-*-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=bundled
X-AppImage-Runtime=static
X-AppImage-Self-Contained=true
