[Desktop Entry]
Name=Actioneer
Comment=Manage GitHub Actions workflows from your desktop
Exec=actioneer
TryExec=actioneer
Icon=me.spaceinbox.actioneer
Terminal=false
Type=Application
Categories=Development;Utility;
Keywords=GitHub;Actions;CI;Workflow;Automation;
StartupNotify=true
StartupWMClass=me.spaceinbox.actioneer
X-GNOME-UsesNotifications=true
X-Purism-FormFactor=Workstation;Mobile;
X-AppImage-Homepage=https://github.com/makoni/actioneer-gtk

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|makoni|actioneer-gtk|latest|actioneer-*x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=bundled
X-AppImage-Runtime=static
X-AppImage-Self-Contained=true
X-AppImage-Payload-License=MIT
