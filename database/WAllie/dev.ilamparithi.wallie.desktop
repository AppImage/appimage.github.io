[Desktop Entry]
Name=WAllie
Exec=AppRun %U
Terminal=false
Type=Application
Icon=wallie
StartupWMClass=dev.ilamparithi.wallie
X-AppImage-Version=1.3.0
Comment=Unofficial Electron-based WhatsApp Client for Linux with Multi-account and Extensions Support
MimeType=x-scheme-handler/whatsapp;x-scheme-handler/wallie;
Categories=Chat;Network;InstantMessaging;

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|ilamparithi-in|WAllie|latest|WAllie-*.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.25
X-AppImage-Payload-License=MIT
