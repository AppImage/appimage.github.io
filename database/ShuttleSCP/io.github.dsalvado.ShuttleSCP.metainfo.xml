<component type="desktop-application">
  <id>io.github.dsalvado.ShuttleSCP</id>
  <name>ShuttleSCP</name>
  <summary>Graphical SFTP and FTP client, inspired by WinSCP</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.dsalvado">
    <name>David Salvador</name>
  </developer>
  <description>
    <p>
      ShuttleSCP shows your computer's files next to a server's and copies between them
      by drag and drop, the right-click menu or the keyboard. It speaks SFTP, SCP, FTP
      and FTPS, keeps passwords in the desktop keyring, resumes interrupted transfers
      and can hold several connections open at once.
    </p>
  </description>
