[Desktop Entry]
Name=Crunchyroll
Comment=Unofficial Crunchyroll desktop client with Widevine DRM, Auto-PiP and MPRIS
Exec=AppRun %U
Terminal=false
Type=Application
Icon=io.github.pulkitmundra.crunchyroll_ubuntu_desktop
StartupWMClass=crunchyroll-linux
Categories=AudioVideo;Video;Player;TV;
Keywords=crunchyroll;anime;streaming;video;

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|pulkitmundra|crunchyroll-ubuntu-desktop|latest|Crunchyroll_Ubuntu_Desktop-*x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.25
X-AppImage-Payload-License=ISC
