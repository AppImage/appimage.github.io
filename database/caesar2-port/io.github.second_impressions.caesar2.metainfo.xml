<component type="desktop-application">
  <id>io.github.second_impressions.caesar2</id>
  <name>Caesar II</name>
  <summary>Build and govern the cities of the Roman Empire</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <developer id="io.github.second_impressions">
    <name>Second Impressions</name>
  </developer>
  <description>
    <p>
      A source port of Impressions Games' Caesar II (1995) for current
      systems. It runs the recovered original game engine on SDL3, plays the
      original music through a faithful OPL3 driver, and reads the game data
      from a player's own installation, CD-ROM, disc image or archive.
    </p>
    <p>
      The original game data is required and is not included.
    </p>
  </description>
  <launchable type="desktop-id">io.github.second_impressions.caesar2.desktop</launchable>
