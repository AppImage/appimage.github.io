<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.jorvik.Jorvik</id>
  <name>Jorvik</name>
  <summary>Self-hosted Matrix client built to feel like Discord</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <developer id="app.jorvik">
    <name>Jorvik contributors</name>
  </developer>

  <description>
    <p>
      Jorvik is a Matrix client that arranges a homeserver the way a chat app
      should feel: Spaces are servers, rooms are channels, and end-to-end
      encryption is on by default.
    </p>
    <p>
      It talks to any Matrix homeserver, so conversations are not tied to one
      provider, and it can be pointed at a server you run yourself.
    </p>
    <p>Features:</p>
    <ul>
      <li>Spaces and channels, with nested subspaces</li>
      <li>End-to-end encrypted messages and encrypted media</li>
      <li>Voice channels</li>
      <li>Custom emoji</li>
      <li>Desktop notifications and an unread badge on the tray icon</li>
    </ul>
  </description>

  <launchable type="desktop-id">jorvik.desktop</launchable>

  <url type="homepage">https://chat.jorvik.app</url>
  <url type="bugtracker">https://github.com/jorvikapp/jorvik/issues</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jorvikapp/jorvik/main/docs/ui.png</image>
      <caption>Channels and conversation</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jorvikapp/jorvik/main/docs/voice.png</image>
      <caption>Voice channels</caption>
    </screenshot>
  </screenshots>

  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>

  <keywords>
    <keyword>matrix</keyword>
    <keyword>chat</keyword>
    <keyword>messaging</keyword>
  </keywords>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>

  <releases>
    <release version="1.0.13" date="2026-09-25"/>
    <release version="1.0.12" date="2026-09-25"/>
    <release version="1.0.11" date="2026-09-24"/>
    <release version="1.0.10" date="2026-09-23"/>
    <release version="1.0.9" date="2026-09-23"/>
    <release version="1.0.8" date="2026-09-23"/>
  </releases>
</component>
