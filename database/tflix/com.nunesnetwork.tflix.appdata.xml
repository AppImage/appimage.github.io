<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for the Linux AppImage and .deb: what app stores and the
     AppImage catalog (appimage.github.io) show about TFLIX. Packed into the
     AppImage at usr/share/metainfo/ (extraFiles in package.json), and into
     /usr/share/metainfo/ by the .deb (deb.fpm in package.json). The name
     ends in .appdata.xml, not .metainfo.xml, because that's the name the
     catalog looks for. Keep the newest <release> at the package.json version:
     the Linux workflow checks it, and validates this file.
     The Flatpak uses it too, renamed to stream.tflix.TFLIX.metainfo.xml with
     that ID and desktop file name (flatpak/stream.tflix.TFLIX.yml and its
     Flathub copy in flatpak/flathub/), so keep
     <id> and <launchable> on one line each, as they are. -->
<component type="desktop-application">
  <id>com.nunesnetwork.tflix</id>
  <name>TFLIX</name>
  <summary>Watch movies and TV shows</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="stream.tflix">
    <name>Tomas Nunes</name>
  </developer>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <description>
    <p>
      TFLIX is a movie and TV show site, powered by TMDB, that streams titles right
      in the app. The desktop app opens the site in its own window and blocks the
      pop-ups and ads that the video players try to open.
    </p>
    <ul>
      <li>Search movies and TV shows, and see their details</li>
      <li>Choose between several streaming servers</li>
      <li>Continue Watching picks up where you stopped, on the right episode</li>
      <li>Save titles to My List, synced across devices with a free account</li>
      <li>A calendar of upcoming episodes and releases for titles in your list</li>
    </ul>
  </description>

  <launchable type="desktop-id">tflix.desktop</launchable>
  <url type="homepage">https://tflix.stream/</url>
  <url type="bugtracker">https://github.com/TomasTNunes/tflix/issues</url>
  <url type="vcs-browser">https://github.com/TomasTNunes/tflix</url>

  <screenshots>
    <screenshot type="default">
      <caption>The home page</caption>
      <image>https://raw.githubusercontent.com/TomasTNunes/tflix/main/assets/screenshots/desktop-home.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.3.1" date="2026-11-13">
      <description>
        <p>When TFLIX can't be reached, the window shows a page with a Try again button instead of staying empty.</p>
      </description>
    </release>
    <release version="1.3.0" date="2026-11-12"/>
  </releases>
</component>
