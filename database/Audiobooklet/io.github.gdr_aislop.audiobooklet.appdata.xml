<!-- AppStream metadata, bundled into the AppImage by scripts/build-appimage.sh -->
<component type="desktop-application">
  <id>io.github.gdr_aislop.audiobooklet</id>
  <name>Audiobooklet</name>
  <name xml:lang="pl">Audiobooklet</name>
  <summary>Client for an Audiobookshelf server, designed for mobile Linux</summary>
  <summary xml:lang="pl">Klient serwera Audiobookshelf zaprojektowany dla mobilnego Linuksa</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.gdr_aislop">
    <name translate="no">gdr-aislop</name>
  </developer>
  <description>
    <p>
      GNOME-native client for an Audiobookshelf media server, designed for
      mobile Linux (Phosh on the Librem 5, also usable on desktop).
    </p>
    <p xml:lang="pl">Natywny dla GNOME klient serwera multimediów Audiobookshelf, zaprojektowany dla mobilnego Linuksa (Phosh na Librem 5, ale działa też na komputerze).</p>
    <p>
      Browse your library, stream or play downloaded audiobooks and podcasts,
      and keep listening progress in sync with the server. Integrates with the
      desktop via MPRIS2 and pauses during phone calls.
    </p>
    <p xml:lang="pl">Przeglądaj bibliotekę, streamuj lub odtwarzaj pobrane audiobooki i podcasty oraz utrzymuj synchronizację postępu słuchania z serwerem. Integruje się z pulpitem przez MPRIS2 i wstrzymuje odtwarzanie podczas połączeń telefonicznych.</p>
  </description>
  <launchable type="desktop-id">io.github.gdr_aislop.audiobooklet.desktop</launchable>
  <!-- The app was called abs-app (shown as "Audiobookshelf") up to 0.9.5. -->
  <replaces>
    <id>io.github.gdr_aislop.abs-app</id>
  </replaces>
