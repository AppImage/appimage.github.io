[Desktop Entry]
Type=Application
Name=Elite Force
GenericName=First-person shooter (single player and Holomatch)
Comment=Single player and Holomatch for Raven Software's Elite Force (unofficial port; bring your own game files)
Exec=AppRun %u
Icon=eliteforce-marino
Terminal=false
Categories=Game;ActionGame;
Keywords=Elite Force;Holomatch;idTech3;FPS;
MimeType=x-scheme-handler/stvef;
StartupWMClass=efsp
Actions=SinglePlayer;Holomatch;DedicatedServer;
X-AppImage-Version=1.4.1

[Desktop Action SinglePlayer]
Name=Single Player
Exec=AppRun --sp

[Desktop Action Holomatch]
Name=Holomatch
Exec=AppRun --holomatch

[Desktop Action DedicatedServer]
Name=Dedicated Server (terminal)
Exec=AppRun --server

[AppImageHub]
# Dear upstream developer, please include update information in your AppImage
# (e.g., with appimagetool -u) so that users can easily update the AppImage
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.30
X-AppImage-Payload-License=GPL-2.0
