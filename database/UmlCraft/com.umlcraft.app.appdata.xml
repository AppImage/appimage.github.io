<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.umlcraft.app</id>
  <name>UmlCraft</name>
  <summary>Draw UML diagrams the way Astah does</summary>
  <developer id="com.umlcraft">
    <name>UmlCraft</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <update_contact>app@umlcraft.com</update_contact>
  <!-- One line per paragraph: snapcraft keeps line breaks inside a paragraph. -->
  <description>
    <p>A UML modeling tool written in Rust with GPUI, built from scratch after the model of Astah Professional. It draws diagrams the way Astah does, opens and writes Astah projects, and imports Java, C#, C++ and Python source code.</p>
    <p>It covers class, object, use case, sequence, activity, state machine, component and deployment diagrams and exports them as SVG and PNG.</p>
  </description>
  <launchable type="desktop-id">com.umlcraft.app.desktop</launchable>
  <provides>
    <binary>umlcraft</binary>
    <mediatype>application/x-umlcraft</mediatype>
  </provides>
  <url type="homepage">https://umlcraft.com/</url>
  <url type="bugtracker">https://github.com/udvlp/UmlCraft/issues</url>
  <url type="vcs-browser">https://github.com/udvlp/UmlCraft</url>
  <screenshots>
    <screenshot type="default">
      <caption>A state machine diagram of the sample project</caption>
      <image>https://raw.githubusercontent.com/udvlp/UmlCraft/main/assets/screenshot.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Development</category>
  </categories>
  <content_rating type="oars-1.1"/>
