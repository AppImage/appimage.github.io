[Desktop Entry]
Name=readm3
Exec=AppRun --no-sandbox %U
Terminal=false
Type=Application
Icon=readm3-desktop
StartupWMClass=readm3
X-AppImage-Version=0.27.0
GenericName=Text Editor
Keywords=text;editor;markdown;code;csv;tsv;table;
Comment=readm3 is a quiet text editor: line numbers, multiple cursors, find and replace, folding, quick open and a command palette, with Markdown rendered as a document. It opens folders from disk and saves back to them, and works offline.
MimeType=text/plain;text/markdown;application/json;text/x-python;text/javascript;text/css;text/html;application/xml;text/x-shellscript;application/x-yaml;text/x-c;text/x-c++;text/x-go;text/x-rust;text/x-java;text/csv;text/tab-separated-values;x-scheme-handler/readm3;
Categories=Development;

[AppImageHub]
# Dear upstream developer, please include update information in your AppImage
# (e.g., with appimagetool -u) so that users can easily update the AppImage
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=dynamic
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.25
X-AppImage-Payload-License=MIT
