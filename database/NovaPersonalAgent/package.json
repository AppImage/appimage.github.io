{
  "name": "@nova-personal-agent/desktop",
  "version": "1.0.2",
  "description": "Nova Personal Agent (NPA) desktop client",
  "homepage": "https://github.com/deepnovacore/NovaPersonalAgent",
  "author": {
    "name": "DeepNova Core",
    "email": "opensource@deepnovacore.ai"
  },
  "private": true,
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs && npm run test:react && node scripts/source-startup-smoke.mjs",
    "test:camera-file": "npm run build --workspace @nova-personal-agent/runtime && electron scripts/camera-file-integration.mjs",
    "test:camera-file:mutations": "node scripts/camera-file-integration-mutations.mjs",
    "test:workbench-agent": "electron scripts/workbench-agent-integration.mjs",
    "smoke:node-backend": "npm run build && electron scripts/utility-runtime-smoke.mjs",
    "smoke:capability-status": "npm run build && electron scripts/utility-runtime-smoke.mjs --capability-status",
    "finalize:mac-notarization": "node scripts/finalize-mac-notarization.mjs --dist-root dist",
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/make-icons.mjs --if-missing && node scripts/build.mjs",
    "build:native:project": "node scripts/build-project-native.mjs",
    "build:native:sandbox-probe": "node scripts/build-codex-sandbox-probe.mjs",
    "build:native:windows-guardian": "node scripts/build-windows-job-guardian.mjs",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "package:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --config.mac.identity=- --config.mac.notarize=false --config.mac.hardenedRuntime=false --mac dir --publish never",
    "package:mac:candidate": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --config.mac.identity=- --config.mac.notarize=false --config.mac.hardenedRuntime=false --mac dmg --publish never",
    "package:mac:release": "npm run build && electron-builder --config electron-builder.yml --mac dmg --publish never",
    "package:win": "npm run build && electron-builder --config electron-builder.yml --win nsis --publish never",
    "package:linux": "npm run build && electron-builder --config electron-builder.yml --linux AppImage deb --publish never",
    "smoke:wake-word": "node scripts/wake-word-smoke.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "test:react": "node scripts/test-react.mjs"
  },
  "dependencies": {
    "@nova-personal-agent/relay": "1.0.2",
    "@nova-personal-agent/runtime": "1.0.2",
    "sherpa-onnx": "1.13.4",
    "tar-stream": "3.1.7",
    "unbzip2-stream": "1.4.3",
    "jose": "6.2.10",
    "qrcode": "1.5.4",
    "ws": "8.21.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@radix-ui/themes": "3.3.0",
    "lucide-react": "1.63.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "node-api-headers": "1.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@playwright/test": "1.64.1"
  },
  "productName": "Nova Personal Agent"
}
