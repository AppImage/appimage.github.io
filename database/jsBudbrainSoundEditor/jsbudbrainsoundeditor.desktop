[Desktop Entry]
Type=Application
Name=jsBudbrainSoundEditor
GenericName=Sound Editor
GenericName[de]=Audio-Editor
Comment=Cut, clean up and polish audio files
Comment[de]=Ton schneiden, bearbeiten und veredeln
Exec=jsBudbrainSoundEditor %F
Icon=jsbudbrainsoundeditor
Terminal=false
Categories=AudioVideo;Audio;AudioVideoEditing;
MimeType=audio/x-wav;audio/wav;audio/vnd.wave;audio/x-aiff;audio/aiff;audio/x-aifc;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/x-opus+ogg;audio/opus;audio/mpeg;audio/mp3;audio/x-mp3;
Keywords=audio;sound;editor;wave;waveform;cut;trim;record;normalize;noise;denoise;tempo;bpm;fade;marker;mp3;flac;ogg;opus;wav;
StartupWMClass=jsbudbrainsoundeditor
X-AppImage-Version=1.0.0

[AppImageHub]
X-AppImage-UpdateInformation=zsync|https://www.budbrain.de/appimage/jsbudbrainsoundeditor-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.34
