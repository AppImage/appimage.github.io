<component type="desktop-application">
  <id>com.reach.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>CoreOps</name>
  <summary>SSH client and remote server manager for Chinese-speaking DevOps engineers</summary>
  <developer id="com.github.Daniel-King-8">
    <name>Daniel-King-8</name>
  </developer>
  <description>
    <p>
      CoreOps is a Chinese-first fork of the Reach SSH client, with an enhanced AI operations assistant.
    </p>
    <ul>
      <li>Tabbed SSH terminals, jump hosts and port forwarding</li>
      <li>SFTP file browser and system monitoring</li>
      <li>Remote desktop over RDP and VNC</li>
      <li>An encrypted vault for sessions and keys, synced between your devices if you choose</li>
      <li>Ansible and OpenTofu automation, databases and a serial console</li>
    </ul>
  </description>
  <launchable type="desktop-id">CoreOps.desktop</launchable>
  <url type="homepage">https://github.com/Daniel-King-8/CoreOps</url>
  <url type="bugtracker">https://github.com/Daniel-King-8/CoreOps/issues</url>
  <url type="vcs-browser">https://github.com/Daniel-King-8/CoreOps</url>
  <screenshots>
    <screenshot type="default">
      <caption>Terminals, sessions and the server monitor</caption>
      <image>https://raw.githubusercontent.com/alexandrosnt/Reach/main/assets/preview.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Network</category>
    <category>System</category>
  </categories>
  <content_rating type="oars-1.1" />
