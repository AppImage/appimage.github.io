[Desktop Entry]
Name=Mundus
Exec=AppRun --no-sandbox %U
Terminal=false
Type=Application
Icon=mundus-app
StartupWMClass=mundus-app
X-AppImage-Version=0.8.65
Comment=A story-creating studio suite that integrates a Write mode to tell your stories, a Characters Mode to store and bring your characters to life including a graphic family tree, a Lore mode where you can describe everything about the world, create timelines and map plotlines on a graph and an interactiveMap mode to visualize your creation. All for as many projects as you like, each with its own data. Supports export and import from and to various formats and cloud sync between devices after setup
Categories=Office;

[AppImageHub]
# Dear upstream developer, please include update information in your AppImage
# (e.g., with appimagetool -u) so that users can easily update the AppImage
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=dynamic
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.25
X-AppImage-Payload-License=AGPL-3.0
