<component type="desktop-application">
  <id>de.budbrain.jsBudbrainsRaidCalculator</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>jsBudbrainsRaidCalculator</name>
  <summary>Plan a disk array: capacity, speed and fault tolerance at a glance</summary>
  <summary xml:lang="de">Plattenverbund planen: Kapazität, Tempo und Ausfallsicherheit auf einen Blick</summary>
  <developer id="de.budbrain">
    <name>Budbrain Software</name>
  </developer>
  <description>
    <p>Enter the size and number of your disks, choose a RAID level and see at once what you get: usable capacity, reading and writing speed, and how many disks may fail.</p>
    <ul>
      <li>JBOD, RAID 0, 1, 5, 6, 10, 50, 60 and triple parity side by side</li>
      <li>Click a disk to let it fail and see whether your data survives</li>
      <li>A step-by-step guide that builds the chosen array with mdadm, every command ready to copy</li>
      <li>Light and dark appearance, 83 languages</li>
    </ul>
  </description>
  <launchable type="desktop-id">jsbudbrainsraidcalculator.desktop</launchable>
  <url type="homepage">https://www.budbrain.de/budbrain-software/</url>
  <url type="contact">https://www.budbrain.de/budbrain-software/</url>
