<!-- AppStream metadata (https://www.freedesktop.org/software/appstream/docs/). The AppImage carries it as
     usr/share/metainfo/com.lynx_share.LYNX.appdata.xml next to com.lynx_share.LYNX.desktop: both file
     names must match the component id (appimagetool looks for <desktop file name>.appdata.xml). -->
<component type="desktop-application">
  <id>com.lynx_share.LYNX</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>LYNX</name>
  <summary>A lightweight digital audio workstation, fully open source</summary>
  <summary xml:lang="pt-BR">Uma estação de trabalho de áudio digital leve e totalmente open-source</summary>
  <description>
    <p>
      LYNX is a pattern-based digital audio workstation for making beats and songs: a channel rack with a step
      sequencer, a piano roll, a playlist, a mixer with effect inserts and sends, automation, and built-in
      instruments and effects. It hosts VST3, CLAP, LV2 and VST2 plugins and opens FL Studio projects (.flp).
    </p>
    <p xml:lang="pt-BR">
      LYNX é uma estação de trabalho de áudio digital baseada em padrões para fazer beats e músicas: channel rack
      com step sequencer, piano roll, playlist, mixer com inserts de efeitos e envios, automação, e instrumentos e
      efeitos próprios. Carrega plugins VST3, CLAP, LV2 e VST2 e abre projetos do FL Studio (.flp).
    </p>
  </description>
  <launchable type="desktop-id">com.lynx_share.LYNX.desktop</launchable>
  <icon type="stock">lynx</icon>
  <url type="homepage">https://lynx-share.com</url>
  <url type="bugtracker">https://github.com/Ka1-S/LYNX/issues</url>
  <url type="vcs-browser">https://github.com/Ka1-S/LYNX</url>
  <developer id="com.lynx_share">
    <name>LYNX contributors</name>
  </developer>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Music</category>
  </categories>
  <keywords>
    <keyword>DAW</keyword>
    <keyword>music</keyword>
    <keyword>MIDI</keyword>
    <keyword>sequencer</keyword>
  </keywords>
