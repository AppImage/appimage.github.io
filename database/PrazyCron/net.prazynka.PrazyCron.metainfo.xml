<component type="desktop-application">
  <id>net.prazynka.PrazyCron</id>
  <name>PrazyCron</name>
  <summary>Cron made simple</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>PrazyCron Task Manager provides graphical and terminal interfaces for inspecting, validating, backing up, and modifying Linux Cron jobs and systemd timers.</p>
    <p>The built-in Cron analyzer works offline and is selected by default. Optional local and online explanation providers can be configured separately.</p>
  </description>
