[Desktop Entry]
Type=Application
Name=Popamp
GenericName=Audio Player
Comment=Winamp-style skinnable audio player
Exec=popamp %U
Icon=popamp
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;player;winamp;skin;mp3;flac;
MimeType=audio/mpeg;audio/mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/x-opus+ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;audio/wav;audio/x-wav;audio/x-aiff;audio/x-matroska;audio/midi;audio/x-midi;audio/x-mod;audio/x-xm;audio/x-s3m;audio/x-it;audio/x-stm;audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;application/xspf+xml;application/x-cue;application/x-popamp-skin;application/x-popamp-vector-skin;
StartupWMClass=popamp
Actions=PlayPause;Next;Previous;
X-AppImage-Version=1.0.1

[Desktop Action PlayPause]
Name=Play/Pause
Exec=popamp /PLAYPAUSE

[Desktop Action Next]
Name=Next
Exec=popamp /NEXT

[Desktop Action Previous]
Name=Previous
Exec=popamp /PREV

[AppImageHub]
# Dear upstream developer, please include update information in your AppImage
# (e.g., with appimagetool -u) so that users can easily update the AppImage
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.35
X-AppImage-Payload-License=Apache-2.0
