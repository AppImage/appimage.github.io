<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.libretro.VirtualJaguar</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Virtual Jaguar</name>
  <summary>Atari Jaguar and Jaguar CD emulator</summary>
  <description>
    <p>Virtual Jaguar emulates the Atari Jaguar console and its CD add-on: the 68000, GPU, DSP and Object Processor, the blitter, the CD drive controller, the Memory Track and GameDrive.</p>
    <p>This desktop app runs the same emulator core as the RetroArch core and adds save states, shaders, cheats, controller remapping and a game library.</p>
    <p>Games are not included. You need your own Jaguar cartridge dumps or CD images.</p>
  </description>
  <launchable type="desktop-id">io.github.libretro.VirtualJaguar.desktop</launchable>
  <url type="homepage">https://jaguar.provenance-emu.com</url>
  <url type="bugtracker">https://github.com/libretro/virtualjaguar-libretro/issues</url>
  <provides>
    <binary>virtualjaguar</binary>
    <mediatype>application/x-atari-jaguar-rom</mediatype>
    <mediatype>application/x-atari-jaguar-cd-image</mediatype>
  </provides>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <developer_name>Virtual Jaguar contributors</developer_name>
