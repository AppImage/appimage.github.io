[Desktop Entry]
Type=Application
Name=PrintView3D
GenericName=3D File Viewer
Comment=View 3D models and G-code files and open them in your slicer
Exec=PrintView3D %f
Icon=printview3d
Terminal=false
Categories=Graphics;3DGraphics;Viewer;
Keywords=3D;print;STL;3MF;OBJ;PLY;glTF;GLB;G-code;gcode;slicer;viewer;
MimeType=model/stl;model/3mf;text/x.gcode;application/sla;application/vnd.ms-3mfdocument;text/x-gcode;model/x.ply;model/x.off;model/obj;model/gltf-binary;model/gltf+json;model/step;application/step;application/x-step;
StartupWMClass=PrintView3D
PrefersNonDefaultGPU=true

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|sevagjb|PrintView3D|latest|PrintView3D-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.35
X-AppImage-Payload-License=MIT
