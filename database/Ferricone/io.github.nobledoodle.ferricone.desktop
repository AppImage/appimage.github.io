[Desktop Entry]
Type=Application
Name=Ferricone Player
GenericName=Media Player
Comment=Play videos, music and streams, with a library beside the player
Exec=ferricone %U
Icon=io.github.nobledoodle.ferricone
Terminal=false
Categories=AudioVideo;Player;Video;Audio;
Keywords=video;movie;music;audio;player;vlc;stream;subtitles;
StartupWMClass=ferricone
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/ogg;video/x-flv;video/x-ms-wmv;video/3gpp;video/mp2t;audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/aac;audio/opus;audio/x-matroska;audio/x-mpegurl;application/vnd.apple.mpegurl;x-scheme-handler/rtsp;x-scheme-handler/mms;

[AppImageHub]
X-AppImage-UpdateInformation=gh-releases-zsync|NobleDoodle|ferricone|latest|Ferricone_Player-*-x86_64.AppImage.zsync
X-AppImage-Signature=directory '/home/runner/.gnupg' created keybox '/home/runner/.gnupg/pubring.kbx' created [don't know]: invalid packet (ctb=0a) no signature found the signature could not be verified. Please remember that the signature file (.sig or .asc) should be the first file given on the command line. 
X-AppImage-Type=2
X-AppImage-Architecture=x86_64
X-AppImage-Libc=host
X-AppImage-Runtime=static
X-AppImage-Self-Contained=false
X-AppImage-Glibc-Required=GLIBC_2.35
X-AppImage-Payload-License=GPL-3.0
