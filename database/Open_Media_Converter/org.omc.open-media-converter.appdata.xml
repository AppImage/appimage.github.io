  <releases>
    <release version="0.1.1" date="2026-09-27">
      <description>
        <p>Fixed AppImage startup on Ubuntu 22.04 and compatible systems with a complete GTK dependency bundle and a modern AppImage runtime.</p>
        <p>Added clean-system portability checks and corrected desktop icons and AppStream metadata.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-27">
      <description>
        <p>Improved conversion correctness, process pause/resume, progress reporting and application logging.</p>
        <p>DEB, RPM and Arch packages use system conversion tools. AppImage bundles FFmpeg, ffprobe and Pandoc. All packages include a Java runtime.</p>
      </description>
    </release>
  </releases>
