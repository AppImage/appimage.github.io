<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>cloud.torreader.TorReader</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>TorReader PDF</name>
  <summary>Fast offline PDF reader, editor and merger</summary>
  <description>
    <p>
      TorReader PDF is a fast, offline, portable PDF reader and editor for large documents.
      Open 200 MB files in 1&#8211;2 seconds, scroll continuously, and view crisp text at any zoom level.
    </p>
    <ul>
      <li>Merge PDFs with bookmark remapping &#8212; preserves bookmark page numbers</li>
      <li>Split by page count or file size, extract or insert pages from other files</li>
      <li>Digital signature (PKCS#7 detached, SHA-256, user certificate)</li>
      <li>Free in-app text translation</li>
      <li>Annotations: freehand, highlight, line/arrow (Shift for straight/45&#176;), text, note, rectangle</li>
      <li>Full-text search (Ctrl+F, result count, sidebar Search tab)</li>
      <li>Reorder / delete pages, dark mode</li>
      <li>100 % offline, local &#8212; no account, no ads, no watermark</li>
    </ul>
  </description>
  <launchable type="desktop-id">cloud.torreader.TorReader.desktop</launchable>
