<!-- The AppImage's AppStream metadata; bundle.sh fills in the release, to
     whose tag the screenshots are pinned. -->
<component type="desktop-application">
  <id>io.github.hobbo91.ferriteweazle</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Ferriteweazle</name>
  <summary>Read, write and convert floppy disks with a Greaseweazle</summary>
  <developer id="io.github.hobbo91">
    <name>Lee Hobson</name>
  </developer>
  <description>
    <p>
      GUI front end for Greaseweazle, Keir Fraser's floppy disk flux reader and writer.
    </p>
    <ul>
      <li>Feature parity with Greaseweazle Tools</li>
      <li>Format detection for disks and images</li>
      <li>Single and batch reads, writes and conversions</li>
      <li>Further read passes over tracks with sectors still missing after gw's retries</li>
      <li>Analyse: each side of the disk, track by track, with its sectors and flux as gw
        decoded them, and the image file as gw lays it out</li>
      <li>Shows each action's gw command line, and passes extra arguments to gw</li>
      <li>Greaseweazle Tools included, unmodified, with its Python; any other gw can be used
        instead</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.hobbo91.ferriteweazle.desktop</launchable>
