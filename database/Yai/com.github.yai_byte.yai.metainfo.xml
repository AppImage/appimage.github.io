<component type="desktop-application">
  <id>com.github.yai_byte.yai</id>
  <name>yai</name>
  <summary>Fast, dependency-light AppImage package manager</summary>
  <description>
    <p>yai installs, updates, upgrades, rolls back and repairs Linux AppImage
    applications. It resolves download URLs from GitHub releases, custom
    repository indexes, AppImageHub feeds and project websites, and keeps every
    installed app independently versioned with rollback snapshots.</p>
  </description>
