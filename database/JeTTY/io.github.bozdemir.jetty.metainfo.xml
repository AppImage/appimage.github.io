<!-- AppStream metadata, installed as usr/share/metainfo/<id>.metainfo.xml in the
     .deb and the AppImage (the AppImage catalog reads it for the app page).
     Check with: appstreamcli validate-tree AppDir
     Add a <release> entry for every release. -->
<component type="desktop-application">
  <id>io.github.bozdemir.jetty</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>JeTTY</name>
  <summary>Blazing-fast GPU terminal you summon with a hotkey</summary>
  <description>
    <p>
      JeTTY is a GPU-accelerated terminal emulator written in Rust. It drops into
      the center of your screen — or slides down from the top, Yakuake-style — on a
      global hotkey, and hides again just as fast, keeping your shells running.
    </p>
    <ul>
      <li>Tabs, scrollback search, hint mode and a keyboard copy mode</li>
      <li>Sixel and Kitty inline images</li>
      <li>Shell integration: jump between prompts and get notified when long commands finish</li>
      <li>Themes, a live-reloaded configuration file and configurable keybindings</li>
      <li>Works on X11 and Wayland, on any desktop environment</li>
    </ul>
  </description>
  <launchable type="desktop-id">jetty.desktop</launchable>
  <url type="homepage">https://github.com/bozdemir/JeTTY</url>
  <url type="bugtracker">https://github.com/bozdemir/JeTTY/issues</url>
  <developer id="io.github.bozdemir">
    <name>Burak Ozdemir</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <caption>A summoned JeTTY window with tabs and a powerlevel10k prompt</caption>
      <image>https://raw.githubusercontent.com/bozdemir/JeTTY/main/assets/screenshots/hero.png</image>
    </screenshot>
    <screenshot>
      <caption>The Neon Night look, one click away in Settings</caption>
      <image>https://raw.githubusercontent.com/bozdemir/JeTTY/main/assets/screenshots/look-neon-night.png</image>
