    <screenshot>
      <caption>The Settings window: one-click Looks and the theme gallery</caption>
      <image>https://raw.githubusercontent.com/bozdemir/JeTTY/main/assets/screenshots/settings.png</image>
    </screenshot>
  </screenshots>
  <categories>
